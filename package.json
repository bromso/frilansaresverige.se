{
  "name": "frilansaresverige.se",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@frilansaresverige/web' dev",
    "build": "bun run --filter '@frilansaresverige/web' build",
    "start": "bun run --filter '@frilansaresverige/web' start",
    "test": "bun test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "storybook": "bun run --filter '@frilansaresverige/story' storybook",
    "build-storybook": "bun run --filter '@frilansaresverige/story' build-storybook"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10"
  }
}
