# Copy to .env.local (gitignored) and fill in as needed.
#
#   cp .env.example apps/web/.env.local
#
# Next.js loads .env.local from the app directory, so it belongs in
# apps/web/, not the repo root.
#
# None of these are required to render the site locally — but two of them
# change behaviour in ways that are easy to miss, so read the notes.


# Slack incoming-webhook the membership form posts applications to.
#
# WITHOUT IT: /api/request-slack-invitation answers 500 with
# {"success":false,"error":"The form is not configured on the server"} and
# the form on /ansokan shows its error notice. The failure is loud, which
# is the intended behaviour: better than silently dropping someone's
# application.
SLACK_REQUEST_INVITE_WEBHOOK_URL=


# Slack incoming-webhook the gig-tip form on /tipsa posts submissions to.
#
# WITHOUT IT: /api/submit-gig-tip answers 500 the same way and the form
# on /tipsa shows its error notice. Loud on purpose, same as above.
SLACK_GIG_TIP_WEBHOOK_URL=


# Google Analytics measurement ID, read in apps/web/pages/_document.tsx.
#
# WITHOUT IT: the gtag snippet is not rendered at all, so analytics
# silently never fire. Nothing errors.
#
# Note this is read at BUILD time for the statically generated pages, so it
# must be present wherever `next build` runs, not just at runtime. deploy.sh
# reads apps/web/.env.local and passes it to the Dockerfile as a build arg;
# the .env.local file itself never enters the image.
GOOGLE_ANALYTICS_ID=


# Base URL for the member-count API shown on the homepage.
#
# WITHOUT IT: defaults to https://uppdrag.frilansaresverige.se/api — i.e.
# local development calls the LIVE production API. Harmless (a 1s timeout
# falls back to the text "flera tusen"), but worth knowing you are hitting
# production from your laptop. Point it elsewhere to avoid that.
API_BASE_URL=

# Skiper UI Pro license (used by the shadcn CLI @skiper-ui registry for
# pro components like skiper103). Get it from skiper-ui.com/pricing.
SKIPER_UI_LICENSE_KEY=
